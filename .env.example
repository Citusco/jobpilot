# Copy this file to .env and adjust if your Postgres differs.
# .env is gitignored — never commit it.

# Matches the pgvector container in README's Getting started:
#   docker run -d --name jobpilot-postgres -p 5432:5432 \
#     -e POSTGRES_USER=jobpilot -e POSTGRES_PASSWORD=jobpilot -e POSTGRES_DB=jobpilot \
#     pgvector/pgvector:pg16
DATABASE_URL="postgresql://jobpilot:jobpilot@localhost:5432/jobpilot"

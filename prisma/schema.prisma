// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model JdSubmission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rawText   String   @map("raw_text")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  items ExtractedItem[]

  @@map("jd_submissions")
}

// One row per distinct technical phrase found in a submission, with its
// resolution outcome (specs/007-jd-concept-graph/data-model.md).
//
// `tier` is not nullable and `conceptId` is: an unresolved item carries
// tier = unresolved with a null concept, so the state is never inferred from
// the null. `score` is null for `exact` -- writing 1.0 would record a
// measurement that never happened.
enum ResolutionTier {
  exact
  similarity
  unresolved
}

model ExtractedItem {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String         @map("submission_id") @db.Uuid
  surface      String
  normalized   String
  evidence     String[]
  conceptId    String?        @map("concept_id")
  tier         ResolutionTier
  score        Float?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  submission JdSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  concept    Concept?     @relation(fields: [conceptId], references: [conceptId], onDelete: Restrict)

  // FR-003 enforced structurally rather than by an application-code check:
  // two mentions of the same phrase cannot become two rows.
  @@unique([submissionId, normalized])
  @@index([submissionId])
  @@index([conceptId])
  @@map("extracted_items")
}

// --- Corpus ingest foundation (specs/005-corpus-ingest-foundation) ---
// Additive only: unrelated to JdSubmission/ExtractedItem above.
// conceptId/chunkId are stable, human-meaningful string primary keys (not
// gen_random_uuid()) — see data-model.md for why.

enum ConceptKind {
  language
  framework
  platform
  architecture
  practice
  tool
  domain
}

enum ConceptStatus {
  candidate
  active
  deprecated
  rejected
}

model Concept {
  conceptId String        @id @map("concept_id")
  name      String
  kind      ConceptKind
  related   String[]
  hasCorpus Boolean       @default(false) @map("has_corpus")
  embedding Unsupported("vector(1536)")?
  status    ConceptStatus @default(candidate)
  addedFrom String        @map("added_from")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  chunks DocChunk[]
  terms  ConceptTerm[]
  items  ExtractedItem[]

  @@map("concepts")
}

enum TermType {
  id
  name
  title
  alias
}

model ConceptTerm {
  term        String   @id
  displayTerm String   @map("display_term")
  conceptId   String   @map("concept_id")
  termType    TermType @map("term_type")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  concept Concept @relation(fields: [conceptId], references: [conceptId], onDelete: Cascade)

  @@index([conceptId])
  @@map("concept_terms")
}

model DocChunk {
  chunkId       String   @id @map("chunk_id")
  patternId     String   @map("pattern_id")
  headingPath   String[] @map("heading_path")
  parentChunkId String?  @map("parent_chunk_id")
  sourceOffset  Int      @map("source_offset")
  sourceLength  Int      @map("source_length")
  embedding     Unsupported("vector(1536)")?
  content       String
  sourceUrl     String   @map("source_url")
  citable       Boolean
  docDate       DateTime? @map("doc_date") @db.Timestamptz
  contentHash   String   @map("content_hash")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  concept  Concept    @relation(fields: [patternId], references: [conceptId], onDelete: Restrict)
  parent   DocChunk?  @relation("ChunkChildren", fields: [parentChunkId], references: [chunkId], onDelete: Cascade)
  children DocChunk[] @relation("ChunkChildren")

  @@index([patternId])
  @@index([contentHash])
  @@index([parentChunkId])
  @@map("doc_chunks")
}

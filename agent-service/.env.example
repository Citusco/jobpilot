# Local override for quick dev iteration only - AWS Secrets Manager
# (agent_service/secrets.py) is the primary path and takes over automatically
# whenever OPENAI_API_KEY is NOT set here. Copy this file to .env only if you
# want to bypass Secrets Manager temporarily; .env is gitignored, never commit it.

# OPENAI_API_KEY=sk-...            # uncomment to override Secrets Manager locally

# Which secret to fetch from AWS Secrets Manager (JSON blob containing
# OPENAI_API_KEY and optionally LANGCHAIN_API_KEY). Defaults to
# jobpilot/agent-service if unset - only set this if you used a different name.
# AGENT_SERVICE_SECRET_NAME=jobpilot/agent-service

# AWS region - required by boto3 if not already set in ~/.aws/config.
# AWS_REGION=us-east-1

# Optional - LangSmith tracing fails open if unset (see spec.md Assumptions).
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=jobpilot-agent-orchestration
